@prefix ek: <https://w3id.org/employee-knowledge/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Employee Knowledge ontology. The model is defined in development/decisions/ ADR-0001
# to ADR-0004. Namespace: ADR-0009.

<https://w3id.org/employee-knowledge/ontology> a owl:Ontology ;
    rdfs:label "Employee Knowledge Ontology" ;
    owl:versionInfo "0.3.1" .

# ---------------------------------------------------------------------------
# Employee identity (ADR-0004)
# ---------------------------------------------------------------------------

ek:Employee a owl:Class ;
    rdfs:label "Employee" ;
    rdfs:comment "A person identified by an employee ID from one issuer. Carries identity only; everything a source says about the person is an ek:FactAssertion." .

ek:employeeId a owl:DatatypeProperty ;
    rdfs:label "employee ID" ;
    rdfs:comment "The employee identifier exactly as issued, trimmed. Unique only together with ek:issuer." ;
    rdfs:domain ek:Employee ;
    rdfs:range xsd:string .

ek:issuer a owl:DatatypeProperty ;
    rdfs:label "issuer" ;
    rdfs:comment "Who issues the employee ID, as configured per source. IDs from different issuers are never merged automatically." ;
    rdfs:domain ek:Employee ;
    rdfs:range xsd:string .

# ---------------------------------------------------------------------------
# Assertable employee properties (ADR-0001)
# ---------------------------------------------------------------------------

ek:AssertableProperty a owl:Class ;
    rdfs:subClassOf owl:DatatypeProperty ;
    rdfs:label "assertable property" ;
    rdfs:comment "An employee attribute a source can make claims about. Used as the object of ek:predicate on an ek:FactAssertion, never directly on an ek:Employee. The rdfs:range is the required datatype of ek:value." .

ek:fullName a ek:AssertableProperty ;
    rdfs:label "full name" ;
    rdfs:comment "The person's full or display name as the source records it. Never an identifier." ;
    rdfs:range xsd:string .

ek:workEmail a ek:AssertableProperty ;
    rdfs:label "work email" ;
    rdfs:comment "Work email address as the source records it, trimmed and lowercased before comparison (ADR-0008)." ;
    rdfs:range xsd:string .

ek:department a ek:AssertableProperty ;
    rdfs:label "department" ;
    rdfs:comment "Department or organisational unit as the source names it." ;
    rdfs:range xsd:string .

ek:jobTitle a ek:AssertableProperty ;
    rdfs:label "job title" ;
    rdfs:comment "Job title as the source records it." ;
    rdfs:range xsd:string .

ek:managerEmployeeId a ek:AssertableProperty ;
    rdfs:label "manager employee ID" ;
    rdfs:comment "Employee ID of the person's manager as the source states it, from the same issuer as the record. To be resolved to an employee, with broken references reported, by data-quality checks (Task-010; architecture §13, question 15)." ;
    rdfs:range xsd:string .

ek:location a ek:AssertableProperty ;
    rdfs:label "work location" ;
    rdfs:comment "Work location as the source records it (office, city or 'Remote')." ;
    rdfs:range xsd:string .

ek:employmentStatus a ek:AssertableProperty ;
    rdfs:label "employment status" ;
    rdfs:comment "Employment status as the source records it. No controlled vocabulary yet (architecture §13, question 11)." ;
    rdfs:range xsd:string .

# ---------------------------------------------------------------------------
# Assertions (ADR-0001)
# ---------------------------------------------------------------------------

ek:FactAssertion a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "fact assertion" ;
    rdfs:comment "One source's claim that one property of one employee has one value. Immutable; trust state comes from review events (ADR-0002)." .

ek:aboutEmployee a owl:ObjectProperty ;
    rdfs:label "about employee" ;
    rdfs:comment "The employee the claim is about." ;
    rdfs:domain ek:FactAssertion ;
    rdfs:range ek:Employee .

ek:predicate a owl:ObjectProperty ;
    rdfs:label "predicate" ;
    rdfs:comment "The assertable property the claim is about." ;
    rdfs:domain ek:FactAssertion ;
    rdfs:range ek:AssertableProperty .

ek:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:comment "The normalised value, typed with the rdfs:range of ek:predicate." ;
    rdfs:domain ek:FactAssertion .

ek:fromSource a owl:ObjectProperty ;
    rdfs:label "from source" ;
    rdfs:comment "The configured source that made the claim (ADR-0007)." ;
    rdfs:domain ek:FactAssertion ;
    rdfs:range ek:Source .

ek:Source a owl:Class ;
    rdfs:label "source" ;
    rdfs:comment "A configured source of employee information (ADR-0007). Never trusted as a whole." .

# ---------------------------------------------------------------------------
# Ingestion runs and observations (ADR-0003)
# ---------------------------------------------------------------------------

ek:IngestionRun a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "ingestion run" ;
    rdfs:comment "One execution of ingestion for one source. Its provenance lives in its own named graph." .

ek:forSource a owl:ObjectProperty ;
    rdfs:label "for source" ;
    rdfs:comment "The configured source this run read (ADR-0003, ADR-0007)." ;
    rdfs:domain ek:IngestionRun ;
    rdfs:range ek:Source .

ek:mappingVersion a owl:DatatypeProperty ;
    rdfs:label "mapping version" ;
    rdfs:comment "The source's mapping_version at the time of the run, so a change to the mapping is visible in provenance (ADR-0007)." ;
    rdfs:domain ek:IngestionRun ;
    rdfs:range xsd:string .

ek:runStatus a owl:ObjectProperty ;
    rdfs:label "run status" ;
    rdfs:comment "Written last; a run without ek:Completed is incomplete and ignored." ;
    rdfs:domain ek:IngestionRun ;
    rdfs:range ek:RunStatus .

ek:RunStatus a owl:Class ;
    rdfs:label "run status" ;
    rdfs:comment "The completion status of an ingestion run." .

ek:Completed a ek:RunStatus ;
    rdfs:label "completed" ;
    rdfs:comment "The run finished. Written last, so a run without it is incomplete and ignored (ADR-0003)." .

ek:fileName a owl:DatatypeProperty ;
    rdfs:label "file name" ;
    rdfs:comment "Name of the source file used by a run." ;
    rdfs:range xsd:string .

ek:sha256 a owl:DatatypeProperty ;
    rdfs:label "SHA-256" ;
    rdfs:comment "Hex SHA-256 digest of the source file used by a run." ;
    rdfs:range xsd:string .

ek:Observation a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "observation" ;
    rdfs:comment "Evidence that a run saw an assertion in a specific source record." .

ek:ofAssertion a owl:ObjectProperty ;
    rdfs:label "of assertion" ;
    rdfs:comment "The assertion this observation is evidence for." ;
    rdfs:domain ek:Observation ;
    rdfs:range ek:FactAssertion .

ek:sourceRecordKey a owl:DatatypeProperty ;
    rdfs:label "source record key" ;
    rdfs:comment "The source's stable key for the record; part of assertion identity." ;
    rdfs:domain ek:Observation ;
    rdfs:range xsd:string .

ek:sourceReference a owl:DatatypeProperty ;
    rdfs:label "source reference" ;
    rdfs:comment "Where the evidence is, e.g. workbook#sheet!row. Not part of identity." ;
    rdfs:range xsd:string .

ek:rawValue a owl:DatatypeProperty ;
    rdfs:label "raw value" ;
    rdfs:comment "The source text exactly as read, before normalisation." ;
    rdfs:domain ek:Observation ;
    rdfs:range xsd:string .

ek:observedAt a owl:DatatypeProperty ;
    rdfs:label "observed at" ;
    rdfs:comment "Observation time supplied by the source. Never defaulted to ingestion time." ;
    rdfs:domain ek:Observation ;
    rdfs:range xsd:dateTime .

ek:validationResult a owl:ObjectProperty ;
    rdfs:label "validation result" ;
    rdfs:comment "Whether the observed value passed the value shapes at the end of the run (ADR-0006). Never changes trust state." ;
    rdfs:domain ek:Observation ;
    rdfs:range ek:ValidationOutcome .

ek:validationMessage a owl:DatatypeProperty ;
    rdfs:label "validation message" ;
    rdfs:comment "The SHACL message for a value-shape violation on this observation (ADR-0006)." ;
    rdfs:domain ek:Observation ;
    rdfs:range xsd:string .

ek:ValidationOutcome a owl:Class ;
    rdfs:label "validation outcome" ;
    rdfs:comment "The result of structural validation of an observed value (ADR-0006)." .

ek:Conforms a ek:ValidationOutcome ;
    rdfs:label "conforms" ;
    rdfs:comment "The observed value passed every value shape." .

ek:Violation a ek:ValidationOutcome ;
    rdfs:label "violation" ;
    rdfs:comment "The observed value failed a value shape. The assertion is still stored, untrusted, and appears in the report (ADR-0006)." .

ek:QuarantinedRecord a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "quarantined record" ;
    rdfs:comment "A source record that could not become assertions, kept with its reason." .

ek:quarantineReason a owl:DatatypeProperty ;
    rdfs:label "quarantine reason" ;
    rdfs:comment "Why the record could not become assertions, for example a missing employee ID." ;
    rdfs:domain ek:QuarantinedRecord ;
    rdfs:range xsd:string .

# ---------------------------------------------------------------------------
# Review (ADR-0002)
# ---------------------------------------------------------------------------

ek:ReviewEvent a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "review event" ;
    rdfs:comment "An explicit reviewer decision about one assertion. Append-only; the only record of trust state." .

ek:reviewAction a owl:ObjectProperty ;
    rdfs:label "review action" ;
    rdfs:comment "The action the reviewer took (ADR-0002)." ;
    rdfs:domain ek:ReviewEvent ;
    rdfs:range ek:ReviewAction .

ek:fromState a owl:ObjectProperty ;
    rdfs:label "from state" ;
    rdfs:comment "The assertion's review state before the event (ADR-0002)." ;
    rdfs:domain ek:ReviewEvent ;
    rdfs:range ek:ReviewState .

ek:toState a owl:ObjectProperty ;
    rdfs:label "to state" ;
    rdfs:comment "The assertion's review state after the event. The state of an assertion is the ek:toState of its latest event (ADR-0002)." ;
    rdfs:domain ek:ReviewEvent ;
    rdfs:range ek:ReviewState .

ek:reviewer a owl:DatatypeProperty ;
    rdfs:label "reviewer" ;
    rdfs:comment "Local reviewer label. Not authentication or authorisation." ;
    rdfs:domain ek:ReviewEvent ;
    rdfs:range xsd:string .

ek:reviewReason a owl:DatatypeProperty ;
    rdfs:label "review reason" ;
    rdfs:comment "The reviewer's stated reason. Required and non-blank for every action." ;
    rdfs:domain ek:ReviewEvent ;
    rdfs:range xsd:string .

ek:policyVersion a owl:DatatypeProperty ;
    rdfs:label "policy version" ;
    rdfs:comment "Version of the authority policy in force when the review was recorded; 'none' when there was none." ;
    rdfs:domain ek:ReviewEvent ;
    rdfs:range xsd:string .

ek:sequence a owl:DatatypeProperty ;
    rdfs:label "sequence" ;
    rdfs:comment "Store-wide, strictly increasing event number." ;
    rdfs:domain ek:ReviewEvent ;
    rdfs:range xsd:integer .

ek:supersededBy a owl:ObjectProperty ;
    rdfs:label "superseded by" ;
    rdfs:comment "On a supersede event only: the existing assertion, about the same employee and property, that replaces the superseded one (ADR-0002)." ;
    rdfs:domain ek:ReviewEvent ;
    rdfs:range ek:FactAssertion .

ek:ReviewAction a owl:Class ;
    rdfs:label "review action" ;
    rdfs:comment "What a reviewer did in a review event. The allowed transitions are in ADR-0002." .

ek:Accept a ek:ReviewAction ;
    rdfs:label "accept" ;
    rdfs:comment "Marks a candidate or needs-evidence assertion as accepted, or restores a superseded one to accepted. Accepted assertions are projected into the trusted graph." .

ek:Reject a ek:ReviewAction ;
    rdfs:label "reject" ;
    rdfs:comment "Marks a candidate or needs-evidence assertion as rejected, or revokes an accepted one to rejected. The source evidence is kept." .

ek:RequestEvidence a ek:ReviewAction ;
    rdfs:label "request evidence" ;
    rdfs:comment "Moves a candidate assertion to needs-evidence: the reviewer needs more evidence before accepting or rejecting it." .

ek:Supersede a ek:ReviewAction ;
    rdfs:label "supersede" ;
    rdfs:comment "Moves an accepted assertion to superseded, optionally naming the assertion that replaces it with ek:supersededBy." .

ek:Reopen a ek:ReviewAction ;
    rdfs:label "reopen" ;
    rdfs:comment "Moves a rejected assertion back to candidate for another review." .

ek:ReviewState a owl:Class ;
    rdfs:label "review state" ;
    rdfs:comment "The trust state of an assertion, derived from its latest review event (ADR-0002)." .

ek:Candidate a ek:ReviewState ;
    rdfs:label "candidate" ;
    rdfs:comment "Not yet decided. The state of every assertion with no review events, and the result of reopen. Untrusted." .

ek:Accepted a ek:ReviewState ;
    rdfs:label "accepted" ;
    rdfs:comment "A reviewer accepted the assertion, by accept or restore. The only trusted state." .

ek:Rejected a ek:ReviewState ;
    rdfs:label "rejected" ;
    rdfs:comment "A reviewer rejected or revoked the assertion. Untrusted; the evidence is kept." .

ek:NeedsEvidence a ek:ReviewState ;
    rdfs:label "needs evidence" ;
    rdfs:comment "A reviewer asked for more evidence before deciding. Untrusted." .

ek:Superseded a ek:ReviewState ;
    rdfs:label "superseded" ;
    rdfs:comment "A reviewer marked a previously accepted assertion as superseded. Untrusted; accept restores it." .
